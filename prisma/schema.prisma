// Satisfy Food Rescue - volunteer management.
//
// Postgres. Conventions:
//  - Calendar dates (shift date, absence range, training completion and
//    expiry, join date) are `@db.Date`. Prisma returns them as a Date at UTC
//    midnight and src/lib/dates.ts treats them as pure "YYYY-MM-DD" days.
//    Wall-clock times are "HH:MM" strings, always Pacific/Auckland.
//  - Instants (sessions, emails, sync times) are ordinary timestamps (UTC).
//  - Enum values match the string unions in packages/core/src/domain.ts, which
//    the native app shares; src/lib/domain.ts fails the build if they drift.
//    Display labels for every value live there too.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AccountRole {
  ADMIN
  VOLUNTEER
}

enum VolunteerStatus {
  ACTIVE
  INACTIVE
}

// What a volunteer can do, and the kind of a shift type. Holding the role is
// the first half of the booking gate; current training is the second.
// HARVEST is the harvest pool, which volunteers join and leave themselves.
enum VolunteerRole {
  WAREHOUSE
  DRIVERS_ASSISTANT
  VOLUNTEER_DRIVER
  HARVEST
}

// A draft is only visible to coordinators; publishing makes it bookable.
enum ShiftStatus {
  DRAFT
  SCHEDULED
  CANCELLED
}

enum AssignmentSource {
  REGULAR
  BOOKED
  COVER
  ADMIN
}

enum AssignmentStatus {
  CONFIRMED
  RELEASED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum AbsenceReason {
  HOLIDAY
  SICK
  OTHER
}

enum Delivery {
  IN_PERSON
  ONLINE_CONFIRM
}

enum TrainingMethod {
  SESSION
  ONLINE
  COORDINATOR
}

enum RsvpStatus {
  GOING
  DECLINED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  DECLINED
}

enum Channel {
  EMAIL
  PUSH
}

enum EmailKind {
  TRAINING_DUE_SOON
  TRAINING_OVERDUE
  TRAINING_OVERDUE_COORDINATOR
  SHIFT_REMINDER
  ABSENCE_CONFIRMED
  COVER_CONFIRMED
  GAP_ALERT
  APPLICATION_APPROVED
  TRAINING_COMPLETED
  SESSION_CONFIRMED
  HARVEST_CALLOUT
  LAST_MINUTE_CALLOUT
  GAP_ESCALATION
  ROLES_CHANGED
  ROLE_CHANGE_REQUEST
  SHIFT_CANCELLED
  SHIFT_ADDED
  SHIFT_PUBLISHED
  ANNOUNCEMENT
  ACCOUNT_INVITE
  PASSWORD_RESET
  ADMIN_ACCESS
}

// PENDING: recorded, not yet handed to the mail or push provider (retried by
// the hourly job). CAPTURED: demo mode, recorded for the Outbox and never sent.
enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  CAPTURED
}

enum AnnouncementAudience {
  ALL
  ROLES
  SHIFT
}

enum ContactLogKind {
  CALL
  NOTE
  PROFILE_UPDATED
  ROLES_CHANGED
  VISIT_BOOKED
  ROLE_REQUEST
  SHIFT_CANCELLED
  ACCOUNT_CREATED
  STATUS_CHANGED
  ADMIN_ACCESS
}

enum AuthTokenPurpose {
  // Emailed when an admin creates an account: set a password and sign in.
  INVITE
  // "Forgot password" and "first time here" both land on this.
  PASSWORD_RESET
  // Hands a Google sign-in from the system browser back to the native app.
  // Lives two minutes and only redeems with the app's PKCE verifier.
  APP_SIGN_IN
}

enum PasskeyCeremony {
  REGISTRATION
  AUTHENTICATION
}

// Where a session lives: a browser cookie, or a bearer token held by the
// native app. They expire differently (see src/lib/session.ts and
// src/lib/mobile-auth.ts).
enum SessionClient {
  WEB
  APP
}

enum DevicePlatform {
  ios
  android
}

// ---------------------------------------------------------------------------
// People and sign-in
// ---------------------------------------------------------------------------

// A person: coordinator/admin or volunteer. Applicants are separate until
// approved (see Application), at which point a Volunteer row is created.
model Volunteer {
  id               String          @id @default(cuid())
  firstName        String
  lastName         String?
  // Always stored lower-cased and trimmed (see normaliseEmail).
  email            String          @unique
  phone            String?
  suburb           String?
  birthYear        Int?
  role             AccountRole     @default(VOLUNTEER)
  status           VolunteerStatus @default(ACTIVE)
  roles            VolunteerRole[] @default([WAREHOUSE])
  isRegular        Boolean         @default(false)
  // Happy to be asked for last-minute cover. Feeds the push notifications and
  // the "last-minute available" list.
  lastMinuteOk     Boolean         @default(false)
  emergencyName    String?
  emergencyPhone   String?
  availabilityNote String?
  notes            String?
  joinedAt         DateTime        @default(now()) @db.Date
  infoodleId       String?
  infoodleSyncedAt DateTime?

  // Null for accounts that have only used Google or a passkey, or have not
  // accepted their invite yet. Password sign-in treats null as "no password"
  // and still runs bcrypt so it fails in constant time.
  passwordHash    String?
  // Set by redeeming an invite or reset link, or by a Google sign-in whose
  // email Google has verified.
  emailVerifiedAt DateTime?
  lastSignInAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions          Session[]
  passkeys          Passkey[]
  oauthAccounts     OAuthAccount[]
  authTokens        AuthToken[]
  passkeyChallenges PasskeyChallenge[]
  pushTokens        PushToken[]
  regularSlots      RegularSlot[]
  assignments       Assignment[]
  absences          Absence[]
  trainingRecords   TrainingRecord[]
  sessionRsvps      SessionRsvp[]
  emails            Email[]
  announcements     Announcement[]
  contactLogs       ContactLog[]       @relation("ContactLogVolunteer")
  authoredLogs      ContactLog[]       @relation("ContactLogAuthor")
}

// A signed-in browser or phone. Only the SHA-256 of the token is stored, so a
// leaked row cannot be replayed as a session.
model Session {
  id          String        @id @default(cuid())
  tokenHash   String        @unique
  volunteerId String
  volunteer   Volunteer     @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  client      SessionClient @default(WEB)
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  // Refreshed at most daily.
  lastSeenAt  DateTime      @default(now())
  userAgent   String?

  @@index([volunteerId])
  @@index([expiresAt])
}

// Single-use sign-in tokens: invite and password-reset links, and the code
// that hands a Google sign-in back to the native app. Only the SHA-256 of the
// token is stored: a reset grants full account takeover, so a leaked row must
// not be redeemable. One live link per volunteer and purpose.
model AuthToken {
  id            String           @id @default(cuid())
  tokenHash     String           @unique
  volunteerId   String
  volunteer     Volunteer        @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  purpose       AuthTokenPurpose
  // APP_SIGN_IN only: the S256 challenge the app's verifier must match.
  codeChallenge String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime         @default(now())

  @@index([volunteerId, purpose])
}

// A WebAuthn challenge issued to the native app, which has no cookie jar to
// keep it in (the website keeps its challenges in an httpOnly cookie). Used
// once, within five minutes. Registration challenges belong to the signed-in
// volunteer; sign-in challenges to nobody yet.
model PasskeyChallenge {
  id          String          @id @default(cuid())
  ceremony    PasskeyCeremony
  challenge   String
  volunteerId String?
  volunteer   Volunteer?      @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime        @default(now())

  @@index([expiresAt])
}

// A registered WebAuthn credential, from a browser or the native app (both
// use the same relying party, the APP_URL host). Discoverable credentials, so
// sign-in is usernameless. publicKey is the raw COSE key.
model Passkey {
  id           String    @id @default(cuid())
  volunteerId  String
  volunteer    Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  // base64url credential id from the authenticator.
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  deviceType   String?
  backedUp     Boolean   @default(false)
  // User-facing label so people can tell devices apart.
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([volunteerId])
}

// A linked Google identity. `providerAccountId` is Google's stable `sub`,
// the same whether the person signed in on the web or in the native app.
model OAuthAccount {
  id                String    @id @default(cuid())
  volunteerId       String
  volunteer         Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime  @default(now())

  @@unique([provider, providerAccountId])
  // At most one account per provider per person, enforced by the database so
  // a double-submitted connect cannot slip past the application check.
  @@unique([volunteerId, provider])
}

// An Expo push token for one of the volunteer's phones. A token belongs to
// one device, so registering it again moves it to whoever signed in last.
model PushToken {
  id          String         @id @default(cuid())
  token       String         @unique
  volunteerId String
  volunteer   Volunteer      @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  platform    DevicePlatform
  deviceName  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lastUsedAt  DateTime?

  @@index([volunteerId])
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

// A collection route. Every route has a paid driver except the one that is
// fully volunteer-driven (isVolunteerDriven). Who drives is shown per shift
// type (ShiftTemplate.workingWith).
model Route {
  id                String          @id @default(cuid())
  name              String
  area              String
  isVolunteerDriven Boolean         @default(false)
  order             Int             @default(0)
  donors            Donor[]
  templates         ShiftTemplate[]
}

// A supermarket or food retailer we collect from.
model Donor {
  id      String @id @default(cuid())
  name    String
  suburb  String
  routeId String
  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
}

// A recipient organisation collecting kai from the warehouse.
model Recipient {
  id       String @id @default(cuid())
  name     String
  location String
  kind     String
}

// The shape of a shift. Recurring shifts are generated from templates (bulk
// scheduling) and regular slots point at a template + weekday. Ad hoc kinds
// (HARVEST) have no weekdays: each shift is created one at a time.
model ShiftTemplate {
  id              String        @id @default(cuid())
  kind            VolunteerRole
  name            String
  routeId         String?
  route           Route?        @relation(fields: [routeId], references: [id], onDelete: SetNull)
  startTime       String
  endTime         String
  capacity        Int
  // Minimum crew for the shift to run comfortably. Confirmed < needed = gap.
  needed          Int
  // ISO weekdays this template normally runs on (1 = Monday). Empty for ad
  // hoc kinds.
  weekdays        Int[]
  // The supervisor or driver volunteers work alongside, e.g. "Dave (staff driver)".
  workingWith     String?
  // A gap that opens within this many hours of the start sends a push
  // notification to eligible last-minute volunteers.
  lastMinuteHours Int           @default(48)
  // Still uncovered this many hours before the start: alert the coordinator.
  escalateHours   Int           @default(24)
  order           Int           @default(0)
  active          Boolean       @default(true)
  shifts          Shift[]
  regularSlots    RegularSlot[]
}

model Shift {
  id            String         @id @default(cuid())
  templateId    String
  template      ShiftTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  date          DateTime       @db.Date
  startTime     String
  endTime       String
  capacity      Int
  needed        Int
  status        ShiftStatus    @default(SCHEDULED)
  // Overrides the template's name and location for one-off shifts, e.g.
  // "Apple picking" at "Loburn orchard, 112 Hodgsons Road".
  title         String?
  location      String?
  // Details for volunteers from the coordinator, shown on the shift and in
  // the callout email.
  notes         String?
  publishedAt   DateTime?
  assignments   Assignment[]
  announcements Announcement[]

  // Not unique: ad hoc kinds can run twice on one day. Bulk scheduling skips
  // dates a template already has a shift on.
  @@index([templateId, date])
  @@index([date])
}

// A volunteer's standing weekly commitment.
model RegularSlot {
  id          String        @id @default(cuid())
  volunteerId String
  volunteer   Volunteer     @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  templateId  String
  template    ShiftTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  // ISO weekday 1 (Mon) .. 5 (Fri)
  weekday     Int

  @@unique([volunteerId, templateId, weekday])
}

// A volunteer on a shift. Regular slots materialise into assignments; an
// absence RELEASES them (creating a gap) and a cover creates a fresh one.
model Assignment {
  id          String           @id @default(cuid())
  shiftId     String
  shift       Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  volunteerId String
  volunteer   Volunteer        @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  source      AssignmentSource @default(BOOKED)
  status      AssignmentStatus @default(CONFIRMED)
  absenceId   String?
  absence     Absence?         @relation(fields: [absenceId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([shiftId])
  @@index([volunteerId])
}

model Absence {
  id                  String        @id @default(cuid())
  volunteerId         String
  volunteer           Volunteer     @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  startDate           DateTime      @db.Date
  endDate             DateTime      @db.Date
  reason              AbsenceReason
  note                String?
  createdAt           DateTime      @default(now())
  releasedAssignments Assignment[]

  @@index([startDate, endDate])
}

// ---------------------------------------------------------------------------
// Training
// ---------------------------------------------------------------------------

model TrainingModule {
  id                        String            @id @default(cuid())
  code                      String            @unique
  name                      String
  description               String
  // Null = valid once, never expires.
  validityMonths            Int?
  requiredRoles             VolunteerRole[]
  mandatoryBeforeFirstShift Boolean           @default(false)
  delivery                  Delivery
  // Read-and-confirm content for ONLINE_CONFIRM modules, paragraphs separated
  // by blank lines.
  content                   String?
  order                     Int               @default(0)
  records                   TrainingRecord[]
  sessions                  TrainingSession[]
  links                     TrainingLink[]
}

// A video or page an online module asks the volunteer to open, usually a
// YouTube video from the SOP or an MPI course. Completion is locked until the
// volunteer has read to the end of the content and opened every link.
model TrainingLink {
  id       String         @id @default(cuid())
  moduleId String
  module   TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  label    String
  url      String
  order    Int            @default(0)

  @@index([moduleId])
}

model TrainingRecord {
  id          String           @id @default(cuid())
  volunteerId String
  volunteer   Volunteer        @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  moduleId    String
  module      TrainingModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  completedAt DateTime         @db.Date
  // Null = never expires.
  expiresAt   DateTime?        @db.Date
  method      TrainingMethod
  sessionId   String?
  session     TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([volunteerId])
  @@index([expiresAt])
}

model TrainingSession {
  id       String           @id @default(cuid())
  moduleId String
  module   TrainingModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  startsAt DateTime
  endsAt   DateTime
  location String
  capacity Int
  notes    String?
  rsvps    SessionRsvp[]
  records  TrainingRecord[]
}

model SessionRsvp {
  id          String          @id @default(cuid())
  sessionId   String
  session     TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  volunteerId String
  volunteer   Volunteer       @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  status      RsvpStatus      @default(GOING)
  attendedAt  DateTime?
  createdAt   DateTime        @default(now())

  @@unique([sessionId, volunteerId])
}

// ---------------------------------------------------------------------------
// Applications and communication
// ---------------------------------------------------------------------------

// A volunteer application awaiting review.
model Application {
  id           String            @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String?
  suburb       String?
  birthYear    Int?
  interests    VolunteerRole[]
  availability String
  message      String?
  source       String            @default("INFOODLE_FORM")
  infoodleId   String?
  submittedAt  DateTime
  status       ApplicationStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewNote   String?
  volunteerId  String?
}

// Every email and push notification the app sends, in one log. It drives the
// Outbox, the profile communication history and reminder de-duplication
// (`ref`), and doubles as the delivery queue: rows are written PENDING and
// handed to the provider (Resend, or Expo for pushes) after the response;
// failures are retried by the hourly job.
model Email {
  id          String         @id @default(cuid())
  volunteerId String?
  volunteer   Volunteer?     @relation(fields: [volunteerId], references: [id], onDelete: SetNull)
  channel     Channel        @default(EMAIL)
  toName      String
  toEmail     String
  kind        EmailKind
  subject     String
  preview     String
  // Paragraphs separated by blank lines.
  body        String
  ctaLabel    String?
  // App-relative path; made absolute when the email is rendered. Null for
  // sign-in links, which are never stored.
  ctaHref     String?
  // Dedupe key for automated messages, e.g. "training-due:<recordId>".
  ref         String?
  status      DeliveryStatus @default(PENDING)
  attempts    Int            @default(0)
  lastError   String?
  // Resend message id, or the Expo push ticket ids.
  providerId  String?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())

  @@index([createdAt])
  @@index([ref])
  @@index([volunteerId, createdAt])
  @@index([status, createdAt])
}

// A message from the coordinator to a group of volunteers: everyone, some
// roles, or the crew of one shift (a harvest that moved, say). Each recipient
// gets an Email row (and a PUSH row when asked) with ref
// "announcement:<id>:<volunteerId>", so it shows on their timeline.
model Announcement {
  id             String               @id @default(cuid())
  subject        String
  // Paragraphs separated by a blank line.
  body           String
  audience       AnnouncementAudience
  // The roles, when audience is ROLES.
  roles          VolunteerRole[]
  shiftId        String?
  shift          Shift?               @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  // Who it went to, in words, kept for the history after a shift is deleted.
  audienceLabel  String
  push           Boolean              @default(false)
  recipientCount Int
  authorId       String?
  author         Volunteer?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())

  @@index([createdAt])
}

// The coordinator's record of contact with a volunteer: phone calls, notes and
// changes made on their behalf. Shown on the profile timeline alongside the
// emails and notifications they were sent.
model ContactLog {
  id          String         @id @default(cuid())
  volunteerId String
  volunteer   Volunteer      @relation("ContactLogVolunteer", fields: [volunteerId], references: [id], onDelete: Cascade)
  authorId    String?
  author      Volunteer?     @relation("ContactLogAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  kind        ContactLogKind
  summary     String
  createdAt   DateTime       @default(now())

  @@index([volunteerId, createdAt])
}

// Small key/value store for operational bookkeeping, e.g. the date the demo
// data was last generated.
model Meta {
  key   String @id
  value String
}
