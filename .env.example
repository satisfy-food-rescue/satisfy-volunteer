# Copy to .env for local development. Production values are set in Coolify.

# Postgres. `docker compose up -d db` serves this one.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/satisfy

# Public origin. Production: https://volunteer.satisfyfoodrescue.org.nz
APP_URL=http://localhost:3000

# 1 = sales demo: persona sign-in, demo data regenerated daily, no email sent.
# Local development runs with the demo seed either way; set this to try the
# persona picker.
DEMO_MODE=

# Email via Resend. Unset in development: emails are printed to the console.
# Required in production (sends refuse to be silently dropped).
RESEND_API_KEY=
# resend (default) or log. "log" prints emails to the server log instead of
# sending them, for a staging copy or the end-to-end tests.
EMAIL_DELIVERY=
EMAIL_FROM=Satisfy Food Rescue <volunteering@satisfyfoodrescue.org.nz>
COORDINATOR_EMAIL=volunteering@satisfyfoodrescue.org.nz

# Google sign-in (optional). One web client serves the website and the native
# app. Authorised redirect URI: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Native app. EXPO_ACCESS_TOKEN only if the Expo project has enhanced push
# security on. APPLE_TEAM_ID and ANDROID_CERT_FINGERPRINTS (comma-separated
# SHA-256 fingerprints, AB:CD:...) let the apps use this site's passkeys.
EXPO_ACCESS_TOKEN=
APPLE_TEAM_ID=
ANDROID_CERT_FINGERPRINTS=

# Shared secret for the hourly scheduler calling /api/cron/tick. Required in
# production. Generate with: openssl rand -hex 32
CRON_SECRET=

# Made an admin on boot while there is no active admin. They sign in with
# Google or set a password through "First time here?" on the sign-in page.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
