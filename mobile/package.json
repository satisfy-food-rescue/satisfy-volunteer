{
  "name": "satisfy-volunteers-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:deps": "expo install --check",
    "doctor": "expo-doctor",
    "typegen": "node scripts/generate-route-types.mjs",
    "build:preview": "npx --yes eas-cli@latest build --profile preview --platform all",
    "build:production": "npx --yes eas-cli@latest build --profile production --platform all",
    "release": "npx --yes eas-cli@latest build --profile production --platform all --auto-submit",
    "submit": "npx --yes eas-cli@latest submit --profile production --platform all --latest",
    "update:preview": "RELEASE_CHANNEL=preview npx --yes eas-cli@latest update --channel preview --environment preview --clear-cache --auto",
    "update:production": "RELEASE_CHANNEL=production npx --yes eas-cli@latest update --channel production --environment production --clear-cache --auto",
    "devices": "npx --yes eas-cli@latest device:create"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/ui": "~57.0.26",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@satisfy/core": "link:../packages/core",
    "@tanstack/react-query": "^5.104.4",
    "expo": "~57.0.31",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-passkeys": "^0.4.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.18.0"
}
