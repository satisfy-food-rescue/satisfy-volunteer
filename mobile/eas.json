{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "remote" },
  "build": {
    "base": { "pnpm": "11.18.0" },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    }
  },
  "submit": { "production": {} }
}
