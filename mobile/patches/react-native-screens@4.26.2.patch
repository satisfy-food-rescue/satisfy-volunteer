+// Assigning an equal value to a tab bar item is not free on iOS 26: UIKit re-measures and
+// repositions the item (-[UITabBarItem _updateViewAndPositionItems:]) and caches the label size.
+// Every item is reconfigured whenever any tab changes (a badge, say). If that lands after the tab
+// buttons exist but before the tab bar's first layout, the labels are measured inside zero-sized
+// buttons and stay clipped and low until each tab is selected. So only real changes are assigned.
+// UIKit copies appearances, so values are compared with isEqual: rather than by identity.
+static BOOL RNSTabBarItemValuesEqual(id _Nullable a, id _Nullable b)
+{
+  return a == b || [a isEqual:b];
+}
